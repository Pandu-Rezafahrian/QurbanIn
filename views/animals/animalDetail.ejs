<!DOCTYPE html>
<html lang="id">
<head>
  <title><%= animal.name %> - QurbanIn</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('../partials/navbar') %>
  <div class="container mt-4" style="max-width:700px">
    <a href="/animals" class="btn btn-outline-secondary btn-sm mb-3">&larr; Kembali</a>
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <h4 class="fw-bold mb-0"><%= animal.name %></h4>
          <span class="badge bg-<%= animal.status === 'tersedia' ? 'success' : 'secondary' %>">
            <%= animal.status %>
          </span>
        </div>
        <table class="table table-bordered">
          <tr><th width="35%">Jenis</th><td class="text-capitalize"><%= animal.type %></td></tr>
          <tr><th>Berat</th><td><%= animal.weight %> kg</td></tr>
          <tr><th>Umur</th><td><%= animal.age %> tahun</td></tr>
          <tr><th>Harga</th><td>Rp <%= animal.price.toLocaleString('id-ID') %></td></tr>
          <tr><th>Kandang</th><td><%= animal.Farm ? animal.Farm.name : '-' %></td></tr>
          <tr><th>Lokasi</th><td><%= animal.Farm ? animal.Farm.location : '-' %></td></tr>
        </table>
        <% if (animal.status === 'tersedia') { %>
          <% if (user) { %>
            <form action="/orders" method="POST">
              <input type="hidden" name="animalId" value="<%= animal.id %>">
              <button class="btn btn-success w-100">Pesan Sekarang</button>
            </form>
          <% } else { %>
            <a href="/login" class="btn btn-outline-success w-100">Login untuk Memesan</a>
          <% } %>
        <% } else { %>
          <button class="btn btn-secondary w-100" disabled>Sudah Terjual</button>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
