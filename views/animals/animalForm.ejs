<!DOCTYPE html>
<html lang="id">
<head>
  <title>Tambah Hewan - QurbanIn</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('../partials/navbar') %>
  <div class="container mt-4" style="max-width:560px">
    <h4 class="fw-bold mb-4">Tambah Hewan Qurban</h4>

    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% errors.forEach(e => { %><li><%= e.message %></li><% }) %>
        </ul>
      </div>
    <% } %>

    <div class="card shadow-sm">
      <div class="card-body p-4">
        <form action="/animals/add" method="POST">
          <div class="mb-3">
            <label class="form-label fw-semibold">Nama Hewan</label>
            <input type="text" name="name" class="form-control" value="<%= animal ? animal.name : '' %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Jenis</label>
            <select name="type" class="form-select" required>
              <option value="">-- Pilih Jenis --</option>
              <option value="sapi"    <%= animal && animal.type==='sapi'    ? 'selected':'' %>>Sapi</option>
              <option value="kambing" <%= animal && animal.type==='kambing' ? 'selected':'' %>>Kambing</option>
              <option value="domba"   <%= animal && animal.type==='domba'   ? 'selected':'' %>>Domba</option>
            </select>
          </div>
          <div class="row">
            <div class="col mb-3">
              <label class="form-label fw-semibold">Berat (kg)</label>
              <input type="number" name="weight" step="0.1" min="20" class="form-control" value="<%= animal ? animal.weight : '' %>" required>
            </div>
            <div class="col mb-3">
              <label class="form-label fw-semibold">Umur (tahun)</label>
              <input type="number" name="age" min="1" class="form-control" value="<%= animal ? animal.age : '' %>" required>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Harga (Rp)</label>
            <input type="number" name="price" min="1500000" class="form-control" value="<%= animal ? animal.price : '' %>" required>
          </div>
          <div class="mb-4">
            <label class="form-label fw-semibold">Kandang</label>
            <select name="farmId" class="form-select" required>
              <option value="">-- Pilih Kandang --</option>
              <% farms.forEach(farm => { %>
                <option value="<%= farm.id %>" <%= animal && animal.farmId===farm.id ? 'selected':'' %>>
                  <%= farm.name %> - <%= farm.location %>
                </option>
              <% }) %>
            </select>
          </div>
          <button type="submit" class="btn btn-success w-100">Simpan</button>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
