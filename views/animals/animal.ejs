<!DOCTYPE html>
<html lang="id">
<head>
  <title>Katalog Hewan - QurbanIn</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('../partials/navbar') %>
  <div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="fw-bold mb-0">Katalog Hewan Qurban</h4>
      <% if (user && user.role === 'admin') { %>
        <a href="/animals/add" class="btn btn-success btn-sm">+ Tambah Hewan</a>
      <% } %>
    </div>

    <% if (animals && animals.length > 0) { %>
      <div class="row g-4">
        <% animals.forEach(animal => { %>
          <div class="col-md-4">
            <div class="card h-100 shadow-sm">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h5 class="fw-bold mb-0"><%= animal.name %></h5>
                  <span class="badge bg-<%= animal.status === 'tersedia' ? 'success' : 'secondary' %>">
                    <%= animal.status %>
                  </span>
                </div>
                <p class="text-muted mb-1 text-capitalize">🐑 <%= animal.type %></p>
                <p class="text-muted mb-1">⚖️ <%= animal.weight %> kg &nbsp;|&nbsp; 📅 <%= animal.age %> tahun</p>
                <p class="text-muted mb-2">🏡 <%= animal.Farm ? animal.Farm.name : '-' %></p>
                <p class="fw-semibold text-success mb-3">Rp <%= animal.price.toLocaleString('id-ID') %></p>
                <a href="/animals/<%= animal.id %>" class="btn btn-outline-success btn-sm w-100">Lihat Detail</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-5">
        <p class="text-muted">Belum ada hewan qurban tersedia.</p>
      </div>
    <% } %>
  </div>
</body>
</html>
