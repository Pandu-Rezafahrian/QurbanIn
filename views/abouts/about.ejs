<!DOCTYPE html>
<html lang="id">
<head>
    <title>Tentang Kami - QurbanIn</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --green: #2e7d32;
            --green-light: #43a047;
            --gold: #fbc02d;
            --gold-light: #fff8e1;
            --dark: #1a1a1a;
            --gray: #6b7280;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: #fafafa; color: var(--dark); }

        /* HERO */
        .about-hero {
            position: relative;
            background: linear-gradient(135deg, #1b5e20 0%, #2e7d32 50%, #f9a825 100%);
            padding: 120px 0 80px;
            overflow: hidden;
            text-align: center;
            color: #fff;
        }
        .about-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at 70% 50%, rgba(251,192,45,0.25) 0%, transparent 60%);
        }
        .about-hero .arabic {
            font-size: 2.8rem;
            opacity: 0.18;
            letter-spacing: 8px;
            position: absolute;
            top: 30px; right: 40px;
            font-family: serif;
        }
        .about-hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2.5rem, 6vw, 4.5rem);
            font-weight: 900;
            position: relative;
            line-height: 1.1;
        }
        .about-hero h1 span { color: var(--gold); }
        .about-hero p {
            font-size: 1.15rem;
            opacity: 0.88;
            max-width: 540px;
            margin: 20px auto 0;
            position: relative;
            line-height: 1.7;
        }
        .scroll-hint {
            position: absolute;
            bottom: 24px; left: 50%;
            transform: translateX(-50%);
            opacity: 0.6;
            animation: bounce 1.8s infinite;
            font-size: 1.4rem;
        }
        @keyframes bounce {
            0%, 100% { transform: translateX(-50%) translateY(0); }
            50% { transform: translateX(-50%) translateY(8px); }
        }

        /* VISI MISI */
        .vm-section { padding: 90px 0; }
        .vm-card {
            background: #fff;
            border-radius: 24px;
            padding: 48px 40px;
            box-shadow: 0 4px 30px rgba(0,0,0,0.07);
            height: 100%;
            position: relative;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .vm-card:hover { transform: translateY(-6px); box-shadow: 0 12px 40px rgba(0,0,0,0.12); }
        .vm-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 5px;
        }
        .vm-card.visi::before { background: linear-gradient(90deg, var(--green), var(--green-light)); }
        .vm-card.misi::before { background: linear-gradient(90deg, var(--gold), #ffca28); }
        .vm-icon {
            width: 64px; height: 64px;
            border-radius: 16px;
            display: flex; align-items: center; justify-content: center;
            font-size: 2rem;
            margin-bottom: 24px;
        }
        .vm-card.visi .vm-icon { background: #e8f5e9; }
        .vm-card.misi .vm-icon { background: var(--gold-light); }
        .vm-card h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 16px;
        }
        .vm-card p { color: var(--gray); line-height: 1.8; font-size: 1rem; }

        /* NILAI */
        .values-section {
            background: linear-gradient(135deg, #f1f8e9, var(--gold-light));
            padding: 90px 0;
        }
        .section-label {
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--green);
            margin-bottom: 12px;
        }
        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: clamp(1.8rem, 4vw, 2.8rem);
            font-weight: 700;
            line-height: 1.2;
        }
        .value-item {
            display: flex;
            align-items: flex-start;
            gap: 20px;
            padding: 28px;
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 2px 16px rgba(0,0,0,0.06);
            transition: transform 0.25s;
        }
        .value-item:hover { transform: translateX(6px); }
        .value-num {
            min-width: 44px; height: 44px;
            background: var(--green);
            color: #fff;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 700;
            font-size: 1rem;
        }
        .value-item h5 { font-weight: 600; margin-bottom: 4px; font-size: 1rem; }
        .value-item p { color: var(--gray); font-size: 0.9rem; margin: 0; line-height: 1.6; }

        /* TEAM / STATS */
        .stats-section { padding: 90px 0; }
        .stat-card {
            text-align: center;
            padding: 40px 20px;
            border-radius: 20px;
            background: #fff;
            box-shadow: 0 2px 20px rgba(0,0,0,0.06);
            transition: transform 0.3s;
        }
        .stat-card:hover { transform: scale(1.04); }
        .stat-number {
            font-family: 'Playfair Display', serif;
            font-size: 3.5rem;
            font-weight: 900;
            color: var(--green);
            line-height: 1;
        }
        .stat-number span { color: var(--gold); }
        .stat-label { color: var(--gray); font-size: 0.95rem; margin-top: 8px; font-weight: 500; }

        /* CTA */
        .cta-section {
            background: var(--green);
            color: #fff;
            padding: 80px 0;
            text-align: center;
        }
        .cta-section h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            font-weight: 700;
            margin-bottom: 12px;
        }
        .cta-section p { opacity: 0.85; margin-bottom: 32px; font-size: 1.05rem; }
        .btn-gold {
            background: var(--gold);
            color: var(--dark);
            font-weight: 700;
            padding: 14px 36px;
            border-radius: 40px;
            border: none;
            font-size: 1rem;
            text-decoration: none;
            transition: transform 0.2s, box-shadow 0.2s;
            display: inline-block;
        }
        .btn-gold:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 24px rgba(251,192,45,0.5);
            color: var(--dark);
        }

        footer { background: #1a1a1a; color: #888; padding: 32px; text-align: center; font-size: 0.9rem; }

        /* ANIMATION */
        .fade-up {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.6s ease, transform 0.6s ease;
        }
        .fade-up.visible { opacity: 1; transform: translateY(0); }
    </style>
</head>
<body>
    <%- include('../partials/navbar') %>

    <!-- HERO -->
    <section class="about-hero">
        <div class="arabic">بِسْمِ اللّٰهِ</div>
        <div class="container">
            <h1>Tentang <span>QurbanIn</span></h1>
            <p>Platform qurban digital yang menghubungkan pembeli dengan peternak lokal terpercaya di seluruh Indonesia.</p>
        </div>
        <div class="scroll-hint">↓</div>
    </section>

    <!-- VISI MISI -->
    <section class="vm-section">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-6 fade-up">
                    <div class="vm-card visi">
                        <div class="vm-icon">🎯</div>
                        <h2>Visi Kami</h2>
                        <p>Menjadi platform qurban digital terpercaya di Indonesia yang menghubungkan jutaan umat Muslim dengan peternak lokal, mewujudkan ibadah qurban yang transparan, mudah, dan bermakna.</p>
                    </div>
                </div>
                <div class="col-md-6 fade-up" style="transition-delay:0.15s">
                    <div class="vm-card misi">
                        <div class="vm-icon">🚀</div>
                        <h2>Misi Kami</h2>
                        <p>Mendukung pertumbuhan peternak lokal dengan teknologi modern, memudahkan masyarakat dalam menjalankan ibadah qurban, serta memastikan setiap hewan memenuhi standar syariat Islam.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- NILAI -->
    <section class="values-section">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-4 fade-up">
                    <p class="section-label">Nilai Kami</p>
                    <h2 class="section-title">Dibangun di atas kepercayaan & kejujuran</h2>
                    <p class="mt-3" style="color:var(--gray);line-height:1.8;">Setiap keputusan di QurbanIn berlandaskan nilai-nilai Islam dan komitmen untuk memberikan yang terbaik.</p>
                </div>
                <div class="col-lg-8">
                    <div class="d-flex flex-column gap-3">
                        <div class="value-item fade-up" style="transition-delay:0.1s">
                            <div class="value-num">01</div>
                            <div>
                                <h5>Transparansi</h5>
                                <p>Setiap informasi hewan, harga, dan peternak ditampilkan secara terbuka dan jujur.</p>
                            </div>
                        </div>
                        <div class="value-item fade-up" style="transition-delay:0.2s">
                            <div class="value-num">02</div>
                            <div>
                                <h5>Kualitas Terjamin</h5>
                                <p>Semua hewan telah melalui seleksi ketat sesuai syarat syariat qurban.</p>
                            </div>
                        </div>
                        <div class="value-item fade-up" style="transition-delay:0.3s">
                            <div class="value-num">03</div>
                            <div>
                                <h5>Dukung Lokal</h5>
                                <p>Kami bermitra dengan peternak lokal untuk memperkuat ekonomi umat.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- STATS -->
    <section class="stats-section">
        <div class="container">
            <div class="text-center mb-5 fade-up">
                <p class="section-label">Dalam Angka</p>
                <h2 class="section-title">QurbanIn Sejauh Ini</h2>
            </div>
            <div class="row g-4">
                <div class="col-6 col-md-3 fade-up" style="transition-delay:0.1s">
                    <div class="stat-card">
                        <div class="stat-number">1<span>K+</span></div>
                        <div class="stat-label">Hewan Terdaftar</div>
                    </div>
                </div>
                <div class="col-6 col-md-3 fade-up" style="transition-delay:0.2s">
                    <div class="stat-card">
                        <div class="stat-number">50<span>+</span></div>
                        <div class="stat-label">Peternak Mitra</div>
                    </div>
                </div>
                <div class="col-6 col-md-3 fade-up" style="transition-delay:0.3s">
                    <div class="stat-card">
                        <div class="stat-number">500<span>+</span></div>
                        <div class="stat-label">Pembeli Puas</div>
                    </div>
                </div>
                <div class="col-6 col-md-3 fade-up" style="transition-delay:0.4s">
                    <div class="stat-card">
                        <div class="stat-number">34<span>+</span></div>
                        <div class="stat-label">Kota Terjangkau</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
        <div class="container">
            <h2>Siap Berqurban Bersama Kami?</h2>
            <p>Bergabung dengan ribuan umat yang sudah mempercayakan qurban mereka kepada QurbanIn.</p>
            <a href="/animals" class="btn-gold">🐑 Lihat Katalog Hewan</a>
        </div>
    </section>

    <footer>
        <p>&copy; 2026 QurbanIn. All rights reserved.</p>
    </footer>

    <script>
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
        }, { threshold: 0.15 });
        document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
    </script>
</body>
</html>
