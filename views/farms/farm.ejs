<!DOCTYPE html>
<html lang="id">
<head>
  <title>Daftar Kandang - QurbanIn</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('../partials/navbar') %>
  <div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="fw-bold mb-0">Daftar Kandang</h4>
      <% if (user && user.role === 'admin') { %>
        <a href="/farms/add" class="btn btn-success btn-sm">+ Tambah Kandang</a>
      <% } %>
    </div>

    <% if (farms && farms.length > 0) { %>
      <div class="row g-4">
        <% farms.forEach(farm => { %>
          <div class="col-md-4">
            <div class="card h-100 shadow-sm">
              <div class="card-body">
                <h5 class="fw-bold mb-1"><%= farm.name %></h5>
                <p class="text-muted mb-1">📍 <%= farm.location %></p>
                <% if (farm.description) { %>
                  <p class="text-muted small mb-0"><%= farm.description %></p>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-5">
        <p class="text-muted">Belum ada kandang terdaftar.</p>
      </div>
    <% } %>
  </div>
</body>
</html>
