<!DOCTYPE html>
<html lang="id">
<head>
  <title>Pesanan Saya - QurbanIn</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('../partials/navbar') %>
  <div class="container mt-4">
    <h4 class="fw-bold mb-4">Pesanan Saya</h4>
    <% if (orders && orders.length > 0) { %>
      <div class="card shadow-sm">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-success">
              <tr>
                <th>#</th>
                <th>Tanggal</th>
                <th>Total Harga</th>
                <th>Status</th>
                <th>Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% orders.forEach((order, i) => { %>
                <tr>
                  <td><%= i + 1 %></td>
                  <td><%= new Date(order.orderDate).toLocaleDateString('id-ID') %></td>
                  <td>Rp <%= order.totalPrice.toLocaleString('id-ID') %></td>
                  <td>
                    <span class="badge bg-<%= order.status === 'confirmed' ? 'success' : order.status === 'cancelled' ? 'danger' : 'warning text-dark' %>">
                      <%= order.status %>
                    </span>
                  </td>
                  <td><a href="/orders/<%= order.id %>" class="btn btn-sm btn-outline-success">Detail</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div class="text-center py-5">
        <p class="text-muted">Belum ada pesanan.</p>
        <a href="/animals" class="btn btn-success">Lihat Katalog Hewan</a>
      </div>
    <% } %>
  </div>
</body>
</html>
