<!DOCTYPE html>
<html lang="id">
<head>
  <title>Detail Pesanan - QurbanIn</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('../partials/navbar') %>
  <div class="container mt-4" style="max-width:700px">
    <a href="/orders" class="btn btn-outline-secondary btn-sm mb-3">&larr; Kembali</a>

    <% if (order) { %>
      <div class="card shadow-sm mb-3">
        <div class="card-header bg-success text-white fw-semibold">
          Detail Pesanan #<%= order.id %>
        </div>
        <div class="card-body">
          <p><strong>Pemesan:</strong> <%= order.User ? order.User.email : '-' %></p>
          <% if (order.User && order.User.UserProfile) { %>
            <p><strong>Nama:</strong> <%= order.User.UserProfile.fullName %></p>
          <% } %>
          <p><strong>Tanggal:</strong> <%= new Date(order.orderDate).toLocaleDateString('id-ID') %></p>
          <p><strong>Total Harga:</strong> Rp <%= order.totalPrice.toLocaleString('id-ID') %></p>
          <p><strong>Status:</strong>
            <span class="badge bg-<%= order.status === 'confirmed' ? 'success' : order.status === 'cancelled' ? 'danger' : 'warning text-dark' %>">
              <%= order.status %>
            </span>
          </p>
          <% if (user && user.role === 'admin' && order.status === 'pending') { %>
            <form action="/orders/<%= order.id %>/confirm" method="POST" class="mt-2">
                <button class="btn btn-success btn-sm">✓ Konfirmasi Order</button>
            </form>
            <% } %>
        </div>
      </div>

      <div class="card shadow-sm">
        <div class="card-header fw-semibold">Item Pesanan</div>
        <div class="table-responsive">
          <table class="table mb-0">
            <thead class="table-light">
              <tr><th>Hewan</th><th>Jenis</th><th>Kandang</th><th>Harga</th></tr>
            </thead>
            <tbody>
              <% order.OrderItems.forEach(item => { %>
                <tr>
                  <td><%= item.Animal ? item.Animal.name : '-' %></td>
                  <td class="text-capitalize"><%= item.Animal ? item.Animal.type : '-' %></td>
                  <td><%= item.Animal && item.Animal.Farm ? item.Animal.Farm.name : '-' %></td>
                  <td>Rp <%= item.price.toLocaleString('id-ID') %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <p class="text-muted">Order tidak ditemukan.</p>
    <% } %>
  </div>
</body>
</html>
