<!DOCTYPE html>
<html lang="id">
<head>
  <title>Profil - QurbanIn</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('../partials/navbar') %>
  <div class="container mt-4" style="max-width:500px">
    <h4 class="fw-bold mb-4">Profil Saya</h4>
    <% if (user) { %>
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <p><strong>Email:</strong> <%= user.email %></p>
          <p><strong>Role:</strong> <span class="badge bg-success"><%= user.role %></span></p>
          <% if (user.UserProfile) { %>
            <hr>
            <p><strong>Nama Lengkap:</strong> <%= user.UserProfile.fullName %></p>
            <p><strong>No. HP:</strong> <%= user.UserProfile.phone || '-' %></p>
            <p class="mb-0"><strong>Alamat:</strong> <%= user.UserProfile.address || '-' %></p>
          <% } %>
        </div>
      </div>
    <% } else { %>
      <p class="text-muted">Tidak ada user yang login.</p>
    <% } %>
  </div>
</body>
</html>
